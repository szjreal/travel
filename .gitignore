# ===== 依赖目录(可重新 npm install 安装,体积大,不上传) =====
node_modules/
**/node_modules/

# ===== 环境变量文件(包含 API Key 等敏感信息,不上传) =====
.env
**/.env
.env.local
**/.env.local

# ===== 构建产物(可重新构建,不上传) =====
dist/
dist-ssr/
build/

# ===== 日志文件 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

